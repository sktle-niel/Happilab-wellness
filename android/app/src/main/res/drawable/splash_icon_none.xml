<?xml version="1.0" encoding="utf-8"?>
<!--
  A blank splash mark.

  Android 12 and up always draw an icon on the launch screen and take the
  launcher icon when told nothing else, so the only way to show none is to hand
  them one with nothing in it. The launcher icon on the home screen is
  untouched.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup and transfer rules.

  Nothing this app stores may leave the device: the encrypted token entry is
  useless without the KeyStore key that stays behind, and a restored copy is
  only a stale credential waiting to be replayed. See CLAUDE.md > Security.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
